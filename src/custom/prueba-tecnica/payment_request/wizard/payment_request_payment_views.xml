<odoo>
    <record id="view_payment_request_payment_wizard_form" model="ir.ui.view">
        <field name="name">payment.request.payment.wizard.form</field>
        <field name="model">payment.request.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar pago">
                <group>
                    <field name="request_id"/>
                    <field name="request_company_id" invisible="1"/>
                    <field name="journal_id"/>
                    <field name="date"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Crear pago"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
