<odoo>
    <record id="rule_payment_request_requester_own" model="ir.rule">
        <field name="name">Payment requests: requester sees own</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('requester_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_requester'))]"/>
    </record>

    <record id="rule_payment_request_approver_assigned" model="ir.rule">
        <field name="name">Payment requests: approver sees assigned</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('approver_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_approver'))]"/>
    </record>

    <record id="rule_payment_request_treasury_company" model="ir.rule">
        <field name="name">Payment requests: treasury sees company requests</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_treasury'))]"/>
    </record>

    <record id="rule_payment_approval_level_company" model="ir.rule">
        <field name="name">Payment approval levels: allowed companies</field>
        <field name="model_id" ref="model_payment_approval_level"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[
            (4, ref('group_payment_request_approver')),
            (4, ref('group_payment_request_treasury'))
        ]"/>
    </record>
</odoo>
