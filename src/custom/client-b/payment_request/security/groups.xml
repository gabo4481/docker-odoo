<odoo>
    <record id="group_payment_request_requester" model="res.groups">
        <field name="name">Solicitante de pagos</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_payment_request_approver" model="res.groups">
        <field name="name">Aprobador de pagos</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('group_payment_request_requester'))
        ]"/>
    </record>

    <record id="group_payment_request_treasury" model="res.groups">
        <field name="name">Tesorería de pagos</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('group_payment_request_requester'))
        ]"/>
    </record>
</odoo>