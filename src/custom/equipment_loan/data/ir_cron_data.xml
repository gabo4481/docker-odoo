<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_equipment_loan_overdue_activity" model="ir.cron">
        <field name="name">Préstamos de equipos: actividades por vencimiento</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="state">code</field>
        <field name="code">model._cron_schedule_overdue_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
