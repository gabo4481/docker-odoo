<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asignar este grupo manualmente a cada gestor desde Ajustes > Usuarios; no se asigna a todos los usuarios internos. -->
    <record id="group_equipment_loan_manager" model="res.groups">
        <field name="name">Gestor de préstamos</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="equipment_loan_rule_own" model="ir.rule">
        <field name="name">Préstamos: cada usuario ve los propios</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="domain_force">[('recipient_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="equipment_loan_rule_manager_all" model="ir.rule">
        <field name="name">Préstamos: el gestor ve todos</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_equipment_loan_manager'))]"/>
    </record>
</odoo>
